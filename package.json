{
  "name": "yocsow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace=@yocsow/desktop",
    "prepare:engine-runner": "node scripts/prepare-engine-runner.mjs",
    "prepare:desktop-bundle": "node scripts/prepare-desktop-bundle.mjs",
    "predev:desktop:native": "npm run prepare:engine-runner",
    "dev:desktop:native": "npm run tauri --workspace=@yocsow/desktop -- dev",
    "build:desktop": "npm run build --workspace=@yocsow/desktop",
    "build:desktop:native": "node scripts/build-desktop-native.mjs",
    "lint:desktop": "npm run lint --workspace=@yocsow/desktop",
    "test:desktop": "npm run test --workspace=@yocsow/desktop"
  },
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0"
}
